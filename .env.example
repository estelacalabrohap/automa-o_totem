# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).

# URL base da aplicação do totem (versão web)
BASE_URL=https://exemplo-totem.com.br

# Credenciais de teste (se a aplicação exigir login)
TOTEM_USER=usuario_teste
TOTEM_PASSWORD=senha_teste

# CPF de teste usado no fluxo de identificação (só números ou com máscara)
TOTEM_CPF=444.254.814-53

# Número de teste usado no fluxo de carteirinha
TOTEM_CARTEIRINHA=00100018276003

# Número de teste de carteirinha bloqueada / inadimplente
TOTEM_CARTEIRINHA_INADIMPLENTE=00225022678000

# Marca como ambiente de CI (preenchido automaticamente em pipelines)
# CI=true
